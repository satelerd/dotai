{
  "cleanupPeriodDays": 36500,
  "env": {
    "SMARTVOC_API_KEY": "__REDACTED__",
    "SMARTVOC_API_URL": "https://backend.dev.smartvoc.ai",
    "ELEVENLABS_API_KEY": "__REDACTED__",
    "ELEVENLABS_VOICE_ID": "ClNifCEVq1smkl4M3aTk"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/whook-permission.sh",
            "timeout": 3900
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/whook-stop.sh",
            "timeout": 3900
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/tmux-agent-status done",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/tmux-agent-status running",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/tmux-agent-status waiting",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/tmux-agent-status clear",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "frontend-design@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "overcast@smartup-plugins": true,
    "whook@smartup-plugins": true,
    "remote-desktop@smartup-plugins": true,
    "fainder@smartup-plugins": true,
    "protocols@smartup-plugins": true,
    "infisical@smartup-plugins": true,
    "autosolve-pipelines@smartup-plugins": true,
    "smartvoc@smartup-plugins": true,
    "devices@dotai-private": true,
    "oye@dotai-private": true,
    "whatsapp@dotai-private": true,
    "shapeup@smartup-plugins": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "smartup-plugins": {
      "source": {
        "source": "github",
        "repo": "SmartUp-Chile/plugins"
      },
      "autoUpdate": true
    }
  },
  "language": "español",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
