prefix_rule(pattern=["open"], decision="allow")
prefix_rule(pattern=["uv", "run"], decision="allow")
prefix_rule(pattern=["python"], decision="allow")
prefix_rule(pattern=["python3"], decision="allow")
prefix_rule(pattern=["az", "login"], decision="allow")
prefix_rule(pattern=["az", "keyvault"], decision="allow")
prefix_rule(pattern=["az", "role"], decision="allow")
prefix_rule(pattern=["top"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "START=$(date -u -v-7d +%Y-%m-%dT%H:%M:%SZ); END=$(date -u +%Y-%m-%dT%H:%M:%SZ); aws cloudtrail lookup-events --region us-west-2 --lookup-attributes AttributeKey=EventSource,AttributeValue=bedrock-runtime.amazonaws.com --start-time \"$START\" --end-time \"$END\" --max-results 50 --output json | head -c 5000"], decision="allow")
prefix_rule(pattern=["cargo", "check"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
